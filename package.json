{
  "name": "blogsystem",
  "version": "0.6.3-maintain2",
  "packageManager": "pnpm@10.27.0",
  "engines": {
    "node": ">=24.12.0"
  },
  "description": "博客系统，可自定义整个网站",
  "main": "./dist/app/blog.js",
  "preferGlobal": true,
  "bin": {
    "blog": "./blog"
  },
  "files": [
    "blog",
    "dist/",
    "static/",
    "sites/default/back.jpg",
    "sites/default/hooks.js",
    "sites/default/index.html",
    "sites/default/scripts/index.js",
    "config/",
    "assets/",
    "index.html",
    "global.json",
    "README.md",
    "README.en.md"
  ],
  "pkg": {
    "scripts": [
      "node_modules/prismjs/components/*.js",
      "dist/app/transforms/**/*.js"
    ],
    "assets": [
      "./static/**/*",
      "./sites/default/**/*",
      "./config/*.json",
      "./assets/**/*",
      "./index.html",
      "./global.json",
      "./static/article_templates/about.md"
    ]
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/gmono/BeautifulBlog"
  },
  "scripts": {
    "clean": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\"",
    "build": "pnpm clean && tsc -p tsconfig.json && tsc -p sites/default/tsconfig.json && esbuild sites/default/scripts/index.tsx --bundle --platform=browser --format=iife --target=es2022 --minify --define:process.env.NODE_ENV='\"production\"' --outfile=sites/default/scripts/index.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "pnpm build && pnpm test:unit",
    "test:unit": "node --test --test-concurrency=1 tests/*.test.cjs",
    "prepack": "pnpm build && pnpm test:unit",
    "gen": "node --trace-warnings ./dist/app/generator.js",
    "watch": "node --trace-warnings ./dist/app/watch.js",
    "trans": "node --trace-warnings ./dist/app/transform.js",
    "site": "node --trace-warnings ./dist/app/changesite.js",
    "refresh": "node --trace-warnings ./dist/app/sitegen.js",
    "server": "node --trace-warnings ./dist/app/sync.js",
    "dev": "node --trace-warnings ./dist/app/dev.js",
    "blog": "node --trace-warnings ./dist/app/blog.js",
    "initBlog": "node --trace-warnings ./dist/app/init.js",
    "pkgall": "pkg -t node24-win-x64,node24-linux-x64 package.json -o ./bin/blog-release",
    "pkgwin": "pkg -t node24-win-x64 package.json -o ./bin/blog-release",
    "pkglinux": "pkg -t node24-linux-x64 package.json -o ./bin/blog-release"
  },
  "author": "gmono",
  "license": "MIT",
  "dependencies": {
    "art-template": "^4.13.4",
    "cheerio": "^1.2.0",
    "chokidar": "^5.0.0",
    "commander": "^15.0.0",
    "copy-dir": "^1.3.0",
    "dateformat": "^5.0.4",
    "fast-deep-equal": "^3.1.3",
    "front-matter": "^4.0.2",
    "fs-extra": "^11.4.1",
    "koa": "^3.2.1",
    "koa-static": "^5.0.0",
    "lodash": "^4.18.1",
    "marked": "^18.1.1",
    "prismjs": "^1.30.0",
    "prompts": "^2.4.2",
    "rxjs": "^7.8.2",
    "toml": "^5.0.1",
    "tslib": "^2.8.1",
    "walk": "^2.3.15"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@yao-pkg/pkg": "^6.23.0",
    "esbuild": "^0.28.2",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "typescript": "^7.0.2"
  },
  "keywords": [
    "blog",
    "blogsystem",
    "static-blog",
    "static-site",
    "website",
    "theme"
  ]
}
